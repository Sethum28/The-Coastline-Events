# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coastline_events

# REQUIRED: long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only needed if the frontend is served from a different origin than the API (comma separated)
CLIENT_ORIGIN=
# Set to 1 if running behind a reverse proxy (nginx, etc.) so rate limiting sees real client IPs
TRUST_PROXY=
